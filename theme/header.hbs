<aside id="site-notification" class="site-notification" role="status" aria-live="polite" aria-atomic="true" hidden>
    <div class="site-notification__inner">
        <span class="site-notification__label" data-notification-label></span>
        <p class="site-notification__message" data-notification-message></p>
        <a class="site-notification__link" data-notification-link hidden></a>
        <button class="site-notification__dismiss" data-notification-dismiss type="button" aria-label="Fechar aviso" hidden>x</button>
    </div>
</aside>
